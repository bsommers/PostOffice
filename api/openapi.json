          "payload": { "type": "string" },
          "is_base64": { "type": "boolean" },
          "timestamp_ns": { "type": "integer" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "StreamAck": {
        "type": "object",
