{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postoffice.meso.io/schemas/v1/route-schema.json",
  "title": "PostOffice Route Specification (v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["source_broker", "source_topic"],
  "properties": {
    "source_broker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "target_broker": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "target_topic": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 1024
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["broker", "topic"],
        "properties": {
          "broker": { "type": "string", "minLength": 1, "maxLength": 128 },
          "topic": { "type": "string", "minLength": 1, "maxLength": 1024 }
        }
      }
    },
    "target_kwargs": {
      "type": "object",
      "properties": {
        "semantic_translation": { "type": "boolean" },
        "source_schema_id": { "type": "integer", "minimum": 1 },
        "target_schema_id": { "type": "integer", "minimum": 1 },
        "strict_validation": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
